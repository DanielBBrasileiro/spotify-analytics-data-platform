AWS_DEFAULT_REGION=us-east-1
SPOTIFY_LAKE_BUCKET=
SPOTIFY_GLUE_JOB_NAME=
# Use temporary AWS credentials; never commit real values.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
# Prefer a private key mounted read-only in ./secrets/.
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
# Password authentication is also supported if the account allows it.
SNOWFLAKE_PASSWORD=
