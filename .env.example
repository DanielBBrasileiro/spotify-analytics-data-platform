# ==============================================================================
# Spotify Analytics Data Platform - Environment Variables Template
#
# IMPORTANT:
# 1. Copy this file to .env before running scripts or services locally.
# 2. NEVER commit actual credentials or the .env file to version control.
# 3. All values below are placeholders and must be populated with your own credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Environment
# ------------------------------------------------------------------------------
ENVIRONMENT=local                          # local | dev | prod
LOG_LEVEL=INFO                             # DEBUG | INFO | WARNING | ERROR

# ------------------------------------------------------------------------------
# Spotify Developer API Credentials (OAuth 2.0 Authorization Code + Refresh Token)
# Registered via https://developer.spotify.com/dashboard
# Required Scopes: playlist-read-private, playlist-read-collaborative
# ------------------------------------------------------------------------------
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REDIRECT_URI=http://localhost:8888/callback
SPOTIFY_REFRESH_TOKEN=your_spotify_refresh_token_here

# ------------------------------------------------------------------------------
# AWS Configuration (Local development & orchestration)
# Preferred: AWS named profile with temporary credentials (e.g., via aws sso login)
# ------------------------------------------------------------------------------
AWS_PROFILE=spotify-dev
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1

# Optional session credentials if not using named profiles:
# AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
# AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
# AWS_SESSION_TOKEN=your_aws_session_token_here

# S3 Data Lake Buckets
S3_BUCKET_NAME=spotify-analytics-data-platform-bronze-us-east-1
# Bronze object keys use the canonical Issue #5 prefix in spotify_data_platform.storage.
# S3_BRONZE_PREFIX=bronze/spotify  # Reserved; arbitrary Bronze prefixes are not supported.
S3_SILVER_PREFIX=silver/spotify
S3_METADATA_PREFIX=metadata

# AWS Glue & Lambda Configuration
GLUE_JOB_NAME=spotify-silver-transformation-job
LAMBDA_EXTRACTOR_NAME=spotify-playlist-raw-extractor
AWS_SECRETS_MANAGER_SECRET_NAME=spotify/api/credentials

# ------------------------------------------------------------------------------
# Snowflake Data Warehouse Configuration
# Always use dedicated least-privilege service roles (never SYSADMIN or ACCOUNTADMIN)
# ------------------------------------------------------------------------------
SNOWFLAKE_ACCOUNT=your_snowflake_account_identifier  # e.g., xy12345.us-east-1
SNOWFLAKE_USER=SPOTIFY_DBT_USER
SNOWFLAKE_PASSWORD=your_snowflake_password_here
SNOWFLAKE_ROLE=SPOTIFY_TRANSFORMER
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=SPOTIFY_ANALYTICS
SNOWFLAKE_SCHEMA=STAGING

# ------------------------------------------------------------------------------
# Apache Airflow 3.x Configuration (Local Docker Compose)
# ------------------------------------------------------------------------------
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=.
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow
